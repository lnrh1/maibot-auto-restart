{
    "manifest_version": 2,
    "id": "lnrh1.maibot-auto-restart",
    "name": "MaiBot自动重启插件",
    "version": "1.0.0",
    "description": "提供阈值触发重启和定时重启功能",
    "author": {
        "name": "lnrh1",
        "url": "https://github.com/lnrh1"
    },
    "urls": {
        "homepage": "https://github.com/lnrh1/maibot-auto-restart",
        "repository": "https://github.com/lnrh1/maibot-auto-restart"
    },
    "license": "MIT",
    "host_application": {
        "min_version": "0.8.0",
        "max_version": "1.2.0"
    },
    "sdk": {
        "min_version": "2.0.0",
        "max_version": "3.0.0"
    },
    "dependencies": [
        {
            "type": "python_package",
            "name": "psutil",
            "version_spec": ">=5.9.0"
        }
    ],
    "capabilities": [
        "send.text"
    ],
    "i18n": {
        "default_locale": "zh_CN"
    }
}
